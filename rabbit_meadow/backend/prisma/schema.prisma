generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum Unit {
  KG
  PIECE
  BUNDLE
}

enum DiscountType {
  FIXED
  PERCENT
}

enum DiscountTargetType {
  PRODUCT
  CATEGORY
}

enum CartStatus {
  ACTIVE
  ABANDONED
}

enum OrderStatus {
  NEW
  PREPARING
  ON_THE_WAY
  DELIVERED
  REJECTED
  CANCELLED
}

enum InventoryMovementType {
  IN
  OUT
  ADJUST
  ORDER_DEDUCT
  RETURN
}

model User {
  id                 String              @id @default(cuid())
  name               String
  phone              String              @unique
  passwordHash       String?
  role               UserRole            @default(CUSTOMER)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  addresses          UserAddress[]
  carts              Cart[]
  orders             Order[]
  createdDiscounts   Discount[]          @relation("DiscountCreator")
  statusLogs         OrderStatusLog[]    @relation("StatusLogChanger")
  inventoryMovements InventoryMovement[] @relation("InventoryMovementCreator")
  settingsUpdated    StoreSetting[]      @relation("StoreSettingUpdater")
}

model UserAddress {
  id        String   @id @default(cuid())
  userId    String
  label     String?
  city      String
  street    String
  building  String?
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@index([userId])
}

model Category {
  id          String      @id @default(cuid())
  slug        String      @unique
  nameAr      String
  nameEn      String?
  imageUrl    String?
  description String?
  isActive    Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  products    Product[]
  discounts   DiscountTarget[]
}

model Product {
  id                 String              @id
  categoryId         String
  nameAr             String
  nameEn             String?
  description        String?
  sku                String?             @unique
  unit               Unit                @default(KG)
  costPrice          Decimal             @default(0) @db.Decimal(10, 2)
  sellPrice          Decimal             @db.Decimal(10, 2)
  stockQty           Decimal             @default(0) @db.Decimal(10, 2)
  minStock           Decimal             @default(0) @db.Decimal(10, 2)
  imageUrl           String?
  isNew              Boolean             @default(false)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  cartItems          CartItem[]
  orderItems         OrderItem[]
  discountTargets    DiscountTarget[]
  inventoryMovements InventoryMovement[]

  @@index([categoryId, isActive])
}

model Discount {
  id          String           @id @default(cuid())
  title       String
  description String?
  bannerUrl   String?
  type        DiscountType
  value       Decimal          @db.Decimal(10, 2)
  startAt     DateTime
  endAt       DateTime
  isActive    Boolean          @default(true)
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   User?            @relation("DiscountCreator", fields: [createdById], references: [id], onDelete: SetNull)
  targets     DiscountTarget[]

  @@index([isActive, startAt, endAt])
}

model DiscountTarget {
  id         String             @id @default(cuid())
  discountId String
  targetType DiscountTargetType
  productId  String?
  categoryId String?
  discount   Discount           @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product    Product?           @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category?          @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([discountId])
  @@index([targetType, productId])
  @@index([targetType, categoryId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String
  status    CartStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@unique([userId, status])
}

model CartItem {
  id                String   @id @default(cuid())
  cartId            String
  productId         String
  qty               Decimal  @default(1) @db.Decimal(10, 2)
  unitPriceSnapshot Decimal  @db.Decimal(10, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  cart              Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
}

model Order {
  id            String           @id @default(cuid())
  orderNumber   String           @unique
  userId        String
  addressId     String?
  status        OrderStatus      @default(NEW)
  subtotal      Decimal          @default(0) @db.Decimal(10, 2)
  discountTotal Decimal          @default(0) @db.Decimal(10, 2)
  deliveryFee   Decimal          @default(0) @db.Decimal(10, 2)
  total         Decimal          @default(0) @db.Decimal(10, 2)
  prepMinutes   Int?
  rejectReason  String?
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  address       UserAddress?     @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  statusLogs    OrderStatusLog[]

  @@index([status, createdAt])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  productId    String?
  nameSnapshot String
  unitPrice    Decimal  @db.Decimal(10, 2)
  qty          Decimal  @db.Decimal(10, 2)
  lineTotal    Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model OrderStatusLog {
  id          String      @id @default(cuid())
  orderId     String
  status      OrderStatus
  changedById String?
  note        String?
  createdAt   DateTime    @default(now())
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy   User?       @relation("StatusLogChanger", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model InventoryMovement {
  id            String                @id @default(cuid())
  productId     String
  type          InventoryMovementType
  qty           Decimal               @db.Decimal(10, 2)
  beforeQty     Decimal               @db.Decimal(10, 2)
  afterQty      Decimal               @db.Decimal(10, 2)
  referenceType String?
  referenceId   String?
  createdById   String?
  createdAt     DateTime              @default(now())
  product       Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy     User?                 @relation("InventoryMovementCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
}

model StoreSetting {
  id          Int      @id
  isOpen      Boolean  @default(true)
  currency    String   @default("SAR")
  usdSarRate  Decimal  @default(3.75) @db.Decimal(10, 2)
  updatedById String?
  updatedAt   DateTime @updatedAt
  updatedBy   User?    @relation("StoreSettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}
